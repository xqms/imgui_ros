<package format="3">
    <name>rqt_imgui</name>
    <version>0.0.1</version>
    <description>imgui integration for ROS and RQT</description>
    <license>MIT</license>
    <maintainer email="max.schwarz@ais.uni-bonn.de">Max Schwarz</maintainer>

    <buildtool_depend>ament_cmake</buildtool_depend>
    <build_depend>qtbase5-dev</build_depend>
    <depend>ament_index_cpp</depend>
    <depend>imgui_ros</depend>
    <depend>pluginlib</depend>
    <depend>qt_gui_cpp</depend>
    <depend>rclcpp</depend>
    <exec_depend>qt_gui</exec_depend>
    <exec_depend>rqt_gui</exec_depend>

    <export>
        <qt_gui plugin="${prefix}/qt_gui_plugin.xml" />
        <build_type>ament_cmake</build_type>
    </export>
</package>
